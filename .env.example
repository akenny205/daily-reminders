# Canvas: Account > Settings > "New Access Token"
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=

# Resend (https://resend.com): sends the digest over HTTPS instead of raw SMTP,
# which some sandboxed environments (e.g. cloud-scheduled runs) can't open sockets for.
# Sign up and create an API key.
RESEND_API_KEY=

# The shared "onboarding@resend.dev" sender needs no domain verification, but can only
# deliver to the email address you used to sign up for Resend. The display name before
# the address (shown in your inbox) can be customized; the address itself can't change
# unless you verify your own sending domain in Resend.
RESEND_FROM=Homework Digest <onboarding@resend.dev>

# Who receives the digest (must be your Resend account's own email if using
# onboarding@resend.dev as the sender).
RECIPIENT_EMAIL=
