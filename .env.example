# Canvas: Account > Settings > "New Access Token"
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=

# Gmail: use an App Password, not your normal password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled on the account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: who receives the digest. Defaults to GMAIL_ADDRESS if left blank.
RECIPIENT_EMAIL=
